{
  "plan_name": "disk_full_and_oom_diagnosis",
  "check_type": "system_health",
  "commands": [
    "df -h",
    "du -xsh /var/log/* 2>/dev/null | sort -hr | head -10",
    "du -xsh /tmp/* 2>/dev/null | sort -hr | head -10",
    "free -h",
    "ps aux --sort=-%mem | head -15",
    "dmesg -T | grep -i 'killed process' | tail -10",
    "journalctl -S '2 hours ago' --no-pager | grep -i 'oom\\|kill' | tail -10"
  ],
  "reasoning": "针对 disk full 和 OOM 告警，需并行检查磁盘使用分布（尤其 /var/log、/tmp）、内存实时占用、OOM Killer 日志及近期内核/系统日志中的 kill 记录，以识别大文件、内存泄漏进程或日志风暴根因。",
