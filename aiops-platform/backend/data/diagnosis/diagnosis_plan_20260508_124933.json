{
  "plan_name": "disk_full_and_oom_diagnosis",
  "check_type": "system_health",
  "commands": [
    "df -h",
    "du -sh /var/log/* 2>/dev/null | sort -hr | head -10",
    "free -h",
    "dmesg -T | grep -i 'killed process' | tail -20",
    "ps aux --sort=-%mem | head -10",
    "swapon --show",
    "find / -xdev -type f -size +100M 2>/dev/null | xargs ls -lhS 2>/dev/null | head -10",
    "journalctl --disk-usage"
  ],
  "reasoning": "针对 disk full 和 OOM 告警，需并行检查磁盘空间分布、内存使用峰值、OOM Killer 日志、高内存进程、swap 状态、巨型文件及 journal 日志占用。所有命令均为安全只读操作。",
